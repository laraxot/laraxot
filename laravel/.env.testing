# Generato da sync-env-testing.sh — NON editare a mano salvo eccezioni documentate.
# Sorgente: laravel/.env | Rigenerare: ./bashscripts/tools/sync-env-testing.sh
# Regola: identico a .env tranne DB_DATABASE* → valore + _test
#
APP_NAME="Sottana Service"
APP_ENV=local
APP_KEY=base64:fcm8njXrCt6V37Lw29sO4YUmeUGhijM0hMsvytJ5IFg=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://techplanner.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techplanner_data_test
DB_USERNAME=marco
DB_PASSWORD=marco

DB_DATABASE_USER=techplanner_user_test
DB_USERNAME_USER=marco
DB_PASSWORD_USER=marco

# Local server is real MySQL 8.0.46, not MariaDB — the tenant config's
# collation default (utf8mb4_uca1400_ai_ci, config/local/techplanner/database.php)
# is a MariaDB-only collation unknown to this server. Override here rather
# than editing that tenant config, which looks like production Forge settings.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
