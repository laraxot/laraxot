includes:
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - ./Modules/Signage/app/Filament/Resources/
        - ./Modules/Catalog/app/Filament/Resources/
        - ./Modules/Bom/app/Filament/Resources/
    type_coverage:
        param: 20
    ignoreErrors:
    excludePaths:
        - ./*/vendor/*
        - ./*/build/*
        - ./*/docs/*
        - ./*/packages/*
        - ./*/*.blade.php
        - ./_ide_helper.php
        - ./_ide_helper_models.php
        - ./Modules/Activity/*
        - ./Modules/Media/*
        - ./Modules/User/*
    scanFiles:
        - ./Modules/Xot/helpers/Helper.php
    tmpDir: /tmp/phpstan
    treatPhpDocTypesAsCertain: false
