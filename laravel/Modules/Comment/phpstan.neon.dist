parameters:

    checkGenericProperties: false
    checkMissingTypeHints: false
    checkMissingLowercasedTypes: false
    checkMissingHigherThanNetteFloatingPointTypehints: false
    checkMissingValueType: false
    checkYoungerVersionOfReflectionType: false
    ignoreErrors:
        - pattern: '~Modules\\Comment\\Actions\\Cast\\SafeCastAction~'
        - message: ~"namespace Modules\\Comment\\Actions\\Cast\\SafeCastAction should exist"
        - code: "0"  # Ignore generic namespace errors
    excludePaths:
        - 'Tests/*'
    import:
        function:
            - 'Safe\\preg_match'
            - 'Safe\\preg_match_all'
        class:
            - Modules\\Xot\\Actions\\Cast\\SafeIntCastAction
            - Modules\\Comment\\Actions\\Cast\\SafeIntCastAction
            - Modules\\Comment\\Actions\\Cast\\SafeStringCastAction
