{
    "name": "laraxot/module_timberbilling_fila5",
    "description": "TimberBilling module (replica gestionale_commesse, Laraxot normalize)",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_timberbilling"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Sottana",
            "email": "marco.sottana@gmail.com"
        },
        {
            "name": "Davide Cavallini",
            "email": "davidecavallini1987@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Modules\\TimberBilling\\": "app/",
            "Modules\\TimberBilling\\Database\\Factories\\": "database/factories/",
            "Modules\\TimberBilling\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\TimberBilling\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\TimberBilling\\Providers\\TimberBillingServiceProvider"
            ],
            "aliases": {}
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../User"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
