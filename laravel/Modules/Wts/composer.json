{
  "name": "laraxot/module_wts_fila5",
  "description": "Wts module \u2014 conferimenti, tracciabilit\u00e0 e audit trail rifiuti",
  "keywords": [
    "laraxot",
    "laravel",
    "filament",
    "module_wts"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Marco Sottana",
      "email": "marco.sottana@gmail.com"
    },
    {
      "name": "Davide Cavallini",
      "email": "davidecavallini1987@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Modules\\Wts\\": "app/",
      "Modules\\Wts\\Database\\Factories\\": "database/factories/",
      "Modules\\Wts\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Wts\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\Wts\\Providers\\WtsServiceProvider",
        "Modules\\Wts\\Providers\\Filament\\AdminPanelProvider"
      ],
      "aliases": {}
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Xot"
    },
    {
      "type": "path",
      "url": "../User"
    },
    {
      "type": "path",
      "url": "../Tenant"
    },
    {
      "type": "path",
      "url": "../UI"
    },
    {
      "type": "path",
      "url": "../Customer"
    },
    {
      "type": "path",
      "url": "../Platform"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wikimedia/composer-merge-plugin": true
    }
  }
}