{
  "name": "laraxot/module_costing_fila5",
  "description": "Costing module (centri di lavoro e ricarichi condivisi tra i moduli di preventivazione)",
  "keywords": ["laraxot", "laravel", "filament", "module_costing"],
  "license": "MIT",
  "authors": [
    {"name": "Marco Sottana", "email": "marco.sottana@gmail.com"},
    {"name": "Davide Cavallini", "email": "davidecavallini1987@gmail.com", "role": "Developer"}
  ],
  "require": {"php": "^8.3"},
  "autoload": {
    "psr-4": {
      "Modules\\Costing\\": "app/",
      "Modules\\Costing\\Database\\Factories\\": "database/factories/",
      "Modules\\Costing\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Modules\\Costing\\Tests\\": "tests/"}},
  "extra": {
    "laravel": {
      "providers": ["Modules\\Costing\\Providers\\CostingServiceProvider"],
      "aliases": {}
    }
  },
  "repositories": [
    {"type": "path", "url": "../Xot"},
    {"type": "path", "url": "../User"},
    {"type": "path", "url": "../Tenant"},
    {"type": "path", "url": "../UI"}
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wikimedia/composer-merge-plugin": true
    }
  }
}
