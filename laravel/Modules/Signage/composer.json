{
  "name": "laraxot/module_signage_fila5",
  "description": "Signage module \u2014 preventivi insegne da file grafici",
  "keywords": [
    "laraxot",
    "laravel",
    "filament",
    "module_signage"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Marco Sottana",
      "email": "marco.sottana@gmail.com"
    },
    {
      "name": "Davide Cavallini",
      "email": "davidecavallini1987@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "smalot/pdfparser": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Modules\\Signage\\": "app/",
      "Modules\\Signage\\Database\\Factories\\": "database/factories/",
      "Modules\\Signage\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Signage\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\Signage\\Providers\\SignageServiceProvider",
        "Modules\\Signage\\Providers\\Filament\\AdminPanelProvider"
      ],
      "aliases": {}
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Xot"
    },
    {
      "type": "path",
      "url": "../User"
    },
    {
      "type": "path",
      "url": "../Tenant"
    },
    {
      "type": "path",
      "url": "../UI"
    },
    {
      "type": "path",
      "url": "../Costing"
    },
    {
      "type": "path",
      "url": "../Quotation"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wikimedia/composer-merge-plugin": true
    }
  }
}