includes:
    # - ./phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ./vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    - ./vendor/pestphp/pest/extension.neon

parameters:
    level: max

    paths:
        - ./Modules/

    ignoreErrors:
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#'
        # PHPStan >=2.2 bleedingEdge marca @internal le Expectation di Pest: chiamarle nei test
        # è l'uso previsto del framework. Falso positivo da upgrade toolchain (2026-08-29),
        # scoping ristretto a identifier+tests. Vedi docs/gestionale-commesse-comparison/delta-second-tranche.md
        -
            identifier: method.internalClass
            path: ./Modules/*/tests/*
            reportUnmatched: false

    excludePaths:
        - ./*/vendor/*
        - ./*/build/*
        - ./*/docs/*
        - ./*/packages/*
        - ./*/*.blade.php
        - ./_ide_helper.php
        - ./_ide_helper_models.php

    bootstrapFiles:
        - ./phpstan_bootstrap.php
        - ./phpstan_constants.php

    scanFiles:
        - ./Modules/Xot/helpers/Helper.php

    editorUrl: 'vscode://file/%%file%%:%%line%%'
    tmpDir: /tmp/phpstan
    treatPhpDocTypesAsCertain: false
    # reportUnmatchedIgnoredErrors: false
