includes:
    # - ./phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ./vendor/pestphp/pest/extension.neon
    - ./vendor/pestphp/pest/phpstan-pest-extension.neon

parameters:
    level: max

    paths:
        - ./Modules/

    ignoreErrors:
        # Pest v3 + PHPStan Level 10 compatibility: Pest's Mixins\Expectation class is marked as @internal
        # but the PHPStan extension doesn't suppress method.internalClass errors
        - '#Call to method.*of internal class Pest\\Mixins\\Expectation#'

    excludePaths:
        - ./*/vendor/*
        - ./*/build/*
        - ./*/docs/*
        - ./*/packages/*
        - ./*/*.blade.php
        # Larastan 3.11.0 isForwardedQueryBuilderMethod() bug — exclude file
        - ./Modules/Intervention/app/Filament/Resources/InterventionResource/Pages/ListInterventions.php
        - ./_ide_helper.php
        - ./_ide_helper_models.php

    # bootstrapFiles (v4 Larastan uses extension.neon instead):
    # - ./phpstan_bootstrap.php
    # - ./phpstan_constants.php

    scanFiles:
        - ./Modules/Xot/helpers/Helper.php

    editorUrl: 'vscode://file/%%file%%:%%line%%'
    tmpDir: /tmp/phpstan
    treatPhpDocTypesAsCertain: false
    # reportUnmatchedIgnoredErrors: false
